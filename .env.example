# Which provider powers the primary judge: "gemini" (default) or "groq"
JUDGE_PROVIDER=gemini

# Get a free key at https://aistudio.google.com/apikey  (no credit card needed)
GEMINI_API_KEY=your_key_here

# Get a free key at https://console.groq.com/keys
# Required if JUDGE_PROVIDER=groq. Also enables the second judge / consensus mode
# when JUDGE_PROVIDER=gemini.
GROQ_API_KEY=

# Optional overrides
PRIMARY_MODEL=gemini-2.5-flash
SECONDARY_MODEL=llama-3.3-70b-versatile
